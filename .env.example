# Server
PORT=4000
HOST=0.0.0.0

# NODE_ENV is intentionally NOT set here. Vite reads .env files at build time
# for its own purposes, so storing NODE_ENV in this file can accidentally leak
# into (and break) production builds. Set NODE_ENV=production via your process
# manager / hosting platform / Docker ENV instead, e.g.:
#   NODE_ENV=production npm start

# Set to "1" (or the number of proxy hops) when running behind a reverse
# proxy/load balancer in production, so rate limiting and req.ip are correct.
# Leave unset for local development.
TRUST_PROXY=

# SQLite database file path (relative to the project root; use an absolute
# path pointing at a persistent volume in production)
DATABASE_PATH=./server/data/tesol.db

# Optional rate-limit tuning (sane defaults are used if left unset)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=10
SUBMISSION_RATE_LIMIT_MAX=5

# Required. Used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Frontend origin allowed for state-changing requests (CSRF defense-in-depth).
# In dev this is the Vite dev server URL; in production it's your deployed domain.
CLIENT_ORIGIN=http://localhost:5173

# One-time bootstrap credentials for the FIRST admin account only. These are
# read once, when the admin_users table is empty, to create that account
# (password is hashed before storage). They are ignored after that account
# exists — remove them from your real .env after the first successful boot.
# Never commit real values here. To change the password later (or create
# additional admins), use: npm run admin:set-password -- <username> <password>
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
